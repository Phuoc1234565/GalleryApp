rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid} {
      allow read, create, update, delete: if owner(uid);
      match /photos/{photoId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.userId == uid
          && request.resource.data.fileName is string
          && request.resource.data.fileSize is int
          && request.resource.data.fileSize >= 0
          && request.resource.data.albumIds is list;
      }
      match /albums/{albumId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.userId == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80;
      }
      match /notifications/{notificationId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && request.resource.data.message is string;
      }
    }
  }
}
