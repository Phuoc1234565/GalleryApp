<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="96dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="10dp">
    <com.google.android.material.card.MaterialCardView android:layout_width="76dp" android:layout_height="76dp" app:cardCornerRadius="10dp" app:strokeWidth="0dp">
        <ImageView android:id="@+id/thumbnail" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="Ảnh trong thùng rác"/>
    </com.google.android.material.card.MaterialCardView>
    <TextView android:id="@+id/caption" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:textColor="@color/text_primary" android:textSize="15sp" android:maxLines="3" android:ellipsize="end" android:lineSpacingExtra="5dp"/>
    <TextView android:id="@+id/check" android:layout_width="28dp" android:layout_height="28dp" android:visibility="gone" android:contentDescription="Đã chọn" android:background="@drawable/bg_selection_number" android:textColor="@color/white" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:gravity="center" android:includeFontPadding="false" android:elevation="2dp"/>
</LinearLayout>
