<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/viewer_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp" app:title="Chỉnh sửa" app:titleTextAppearance="@style/GalleryToolbarTitle" app:titleTextColor="@color/text_primary" app:navigationIcon="@drawable/ic_arrow_back" app:navigationIconTint="@color/text_primary"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:paddingHorizontal="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/undo" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="Hoàn tác" android:textSize="13sp" android:letterSpacing="0" android:paddingHorizontal="4dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/redo" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="Làm lại" android:textSize="13sp" android:letterSpacing="0" android:paddingHorizontal="4dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/resetEditor" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="Khôi phục gốc" android:textSize="13sp" android:letterSpacing="0" android:paddingHorizontal="4dp"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginHorizontal="16dp" android:layout_marginVertical="8dp">
        <com.example.appanh.editor.EditorCanvasView android:id="@+id/photo" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp"/>
        <ProgressBar android:id="@+id/editorBusy" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center"/>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/crop" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:text="Cắt" android:textSize="12sp" android:paddingHorizontal="0dp" app:icon="@drawable/ic_crop" app:iconGravity="textTop" app:iconSize="21dp" app:iconTint="@color/text_primary" android:textColor="@color/text_primary"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/filter" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:text="Bộ lọc" android:textSize="12sp" android:paddingHorizontal="0dp" app:icon="@drawable/ic_filter" app:iconGravity="textTop" app:iconSize="21dp" app:iconTint="@color/text_primary" android:textColor="@color/text_primary"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/adjust" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:text="Điều chỉnh" android:textSize="12sp" android:paddingHorizontal="0dp" app:icon="@drawable/ic_settings" app:iconGravity="textTop" app:iconSize="21dp" app:iconTint="@color/text_primary" android:textColor="@color/text_primary"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/draw" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:text="Vẽ" android:textSize="12sp" android:paddingHorizontal="0dp" app:icon="@drawable/ic_edit" app:iconGravity="textTop" app:iconSize="21dp" app:iconTint="@color/text_primary" android:textColor="@color/text_primary"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:background="@color/viewer_controls">
        <LinearLayout android:id="@+id/cropPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/ratioFree" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="Tự do" android:textSize="13sp" android:letterSpacing="0" android:paddingHorizontal="4dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/ratioSquare" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="1:1" android:textSize="13sp" android:letterSpacing="0" android:paddingHorizontal="4dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/ratioPortrait" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="4:3" android:textSize="13sp" android:letterSpacing="0" android:paddingHorizontal="4dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/ratioWide" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="16:9" android:textSize="13sp" android:letterSpacing="0" android:paddingHorizontal="4dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/rotate" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="Xoay 90°" android:textSize="13sp" android:letterSpacing="0" android:paddingHorizontal="4dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/applyCrop" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="Áp dụng cắt" android:textSize="13sp" android:letterSpacing="0" android:paddingHorizontal="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <HorizontalScrollView android:id="@+id/filterPanel" android:layout_width="match_parent" android:layout_height="48dp" android:visibility="gone" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/filterOriginal" style="@style/TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Gốc" android:textSize="13sp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/filterMono" style="@style/TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Trắng đen" android:textSize="13sp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/filterSepia" style="@style/TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Cổ điển" android:textSize="13sp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/filterWarm" style="@style/TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Ấm" android:textSize="13sp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/filterCool" style="@style/TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Lạnh" android:textSize="13sp"/>
            </LinearLayout>
        </HorizontalScrollView>
        <LinearLayout android:id="@+id/adjustPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="86dp" android:layout_height="wrap_content" android:text="Độ sáng" android:textSize="13sp" android:textColor="@color/text_secondary"/>
                <SeekBar android:id="@+id/brightness" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:max="200" android:progress="100"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="86dp" android:layout_height="wrap_content" android:text="Tương phản" android:textSize="13sp" android:textColor="@color/text_secondary"/>
                <SeekBar android:id="@+id/contrast" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:max="150" android:progress="50"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/drawPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center">
                <com.google.android.material.button.MaterialButton android:id="@+id/brushWhite" style="@style/PrimaryButton" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginHorizontal="5dp" android:minWidth="0dp" android:padding="0dp" android:backgroundTint="@color/white" android:contentDescription="Bút trắng" app:cornerRadius="18dp" app:strokeWidth="1dp" app:strokeColor="@color/field_border"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/brushBlack" style="@style/PrimaryButton" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginHorizontal="5dp" android:minWidth="0dp" android:padding="0dp" android:backgroundTint="@color/black" android:contentDescription="Bút đen" app:cornerRadius="18dp" app:strokeWidth="1dp" app:strokeColor="@color/field_border"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/brushRed" style="@style/PrimaryButton" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginHorizontal="5dp" android:minWidth="0dp" android:padding="0dp" android:backgroundTint="#EF4444" android:contentDescription="Bút đỏ" app:cornerRadius="18dp" app:strokeWidth="1dp" app:strokeColor="@color/field_border"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/brushBlue" style="@style/PrimaryButton" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginHorizontal="5dp" android:minWidth="0dp" android:padding="0dp" android:backgroundTint="#2563EB" android:contentDescription="Bút xanh dương" app:cornerRadius="18dp" app:strokeWidth="1dp" app:strokeColor="@color/field_border"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/brushGreen" style="@style/PrimaryButton" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginHorizontal="5dp" android:minWidth="0dp" android:padding="0dp" android:backgroundTint="#16A34A" android:contentDescription="Bút xanh lá" app:cornerRadius="18dp" app:strokeWidth="1dp" app:strokeColor="@color/field_border"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/brushYellow" style="@style/PrimaryButton" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginHorizontal="5dp" android:minWidth="0dp" android:padding="0dp" android:backgroundTint="#FACC15" android:contentDescription="Bút vàng" app:cornerRadius="18dp" app:strokeWidth="1dp" app:strokeColor="@color/field_border"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:text="Nét bút" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                <SeekBar android:id="@+id/brushWidth" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:max="29" android:progress="5"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/clearDrawing" style="@style/TextButton" android:layout_width="92dp" android:layout_height="44dp" android:text="Xóa nét" android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="@color/text_secondary" android:fontFamily="sans-serif" android:id="@+id/status" android:paddingHorizontal="20dp" android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:paddingHorizontal="16dp" android:paddingVertical="8dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/cancelEdit" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="Hủy" android:textSize="13sp" android:letterSpacing="0" android:paddingHorizontal="4dp" android:layout_marginEnd="8dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/save" style="@style/PrimaryButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="Lưu bản sao" android:textSize="13sp" android:letterSpacing="0" android:paddingHorizontal="4dp"/>
    </LinearLayout>
</LinearLayout>
