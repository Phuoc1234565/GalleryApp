<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp" app:title="Ảnh" app:titleTextAppearance="@style/GalleryToolbarTitle" app:titleTextColor="@color/text_primary" app:navigationIcon="@drawable/ic_arrow_back" app:navigationIconTint="@color/text_primary"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="16dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_search_bar">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="14dp" android:src="@drawable/ic_search" app:tint="@color/text_secondary" android:importantForAccessibility="no"/>
            <androidx.appcompat.widget.AppCompatEditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:paddingStart="44dp" android:paddingEnd="12dp" android:paddingTop="0dp" android:paddingBottom="0dp" android:gravity="center_vertical" android:includeFontPadding="true" android:fontFamily="sans-serif" android:singleLine="true" android:hint="Tìm kiếm ảnh, video…" android:textSize="15sp" android:inputType="text" android:imeOptions="actionSearch" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"/>
        </FrameLayout>
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" app:singleLine="false" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="6dp">
            <com.google.android.material.chip.Chip android:id="@+id/all" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Tất cả" android:textSize="14sp" android:textColor="@color/chip_text" android:checkable="true" android:checked="true" app:chipBackgroundColor="@color/chip_background" app:chipStrokeColor="@color/field_border" app:chipStrokeWidth="1dp" app:checkedIconVisible="false" app:chipCornerRadius="18dp" app:ensureMinTouchTargetSize="true"/>
            <com.google.android.material.chip.Chip android:id="@+id/images" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Ảnh" android:textSize="14sp" android:textColor="@color/chip_text" android:checkable="true" android:checked="false" app:chipBackgroundColor="@color/chip_background" app:chipStrokeColor="@color/field_border" app:chipStrokeWidth="1dp" app:checkedIconVisible="false" app:chipCornerRadius="18dp" app:ensureMinTouchTargetSize="true"/>
            <com.google.android.material.chip.Chip android:id="@+id/videos" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Video" android:textSize="14sp" android:textColor="@color/chip_text" android:checkable="true" android:checked="false" app:chipBackgroundColor="@color/chip_background" app:chipStrokeColor="@color/field_border" app:chipStrokeWidth="1dp" app:checkedIconVisible="false" app:chipCornerRadius="18dp" app:ensureMinTouchTargetSize="true"/>
            <com.google.android.material.chip.Chip android:id="@+id/favorites" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Yêu thích" android:contentDescription="Ảnh và video yêu thích" android:textSize="14sp" android:textColor="@color/chip_text" android:checkable="true" android:checked="false" app:chipBackgroundColor="@color/chip_background" app:chipStrokeColor="@color/field_border" app:chipStrokeWidth="1dp" app:checkedIconVisible="false" app:chipCornerRadius="18dp" app:ensureMinTouchTargetSize="true"/>
        </com.google.android.material.chip.ChipGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="@color/text_secondary" android:fontFamily="sans-serif" android:id="@+id/status" android:visibility="gone" android:paddingVertical="8dp"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingBottom="84dp" android:clipToPadding="false"/>
            <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:visibility="gone" android:padding="28dp">
                <ImageView android:layout_width="180dp" android:layout_height="150dp" android:src="@drawable/art_splash" android:contentDescription="Thư viện của bạn"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lưu giữ những điều bạn yêu" android:textSize="20sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif" android:gravity="center" android:layout_marginTop="16dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Thêm ảnh hoặc video đầu tiên để bắt đầu câu chuyện của bạn." android:textSize="15sp" android:textColor="@color/text_secondary" android:fontFamily="sans-serif" android:gravity="center" android:layout_marginTop="10dp" android:lineSpacingExtra="4dp"/>
            </LinearLayout>
            <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/importMedia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="16dp" android:src="@drawable/ic_add" android:contentDescription="Thêm ảnh hoặc video" app:backgroundTint="@color/button_primary" app:tint="@color/white" app:fabCustomSize="56dp"/>
        </FrameLayout>
    </LinearLayout>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/navigation" android:layout_width="match_parent" android:layout_height="68dp" android:background="@color/surface" app:menu="@menu/bottom_navigation_menu" app:labelVisibilityMode="labeled" app:itemIconTint="@color/nav_colors" app:itemTextColor="@color/nav_colors" app:itemTextAppearanceActive="@style/GalleryNavigationText" app:itemTextAppearanceInactive="@style/GalleryNavigationText"/>
</LinearLayout>
