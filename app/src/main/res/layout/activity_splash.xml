<?xml version="1.0" ?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_auth_surface">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp" app:title="" app:titleTextAppearance="@style/GalleryToolbarTitle" app:titleTextColor="@color/text_primary" app:navigationIcon="@drawable/ic_arrow_back" app:navigationIconTint="@color/text_primary" android:visibility="gone"/>
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <androidx.constraintlayout.widget.Guideline android:id="@+id/heroAnchor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.14"/>
        <ImageView android:id="@+id/welcomeLogo" android:layout_width="80dp" android:layout_height="80dp" android:padding="10dp" android:background="@drawable/bg_logo_tile" android:elevation="3dp" android:src="@drawable/ic_app_logo" android:contentDescription="Ảnh" app:layout_constraintTop_toBottomOf="@id/heroAnchor" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
        <TextView android:id="@+id/welcomeTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ảnh" android:textSize="46sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" android:layout_marginTop="12dp" app:layout_constraintTop_toBottomOf="@id/welcomeLogo" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
        <TextView android:id="@+id/welcomeSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lưu giữ khoảnh khắc đẹp" android:textColor="@color/text_secondary" android:textSize="16sp" android:layout_marginTop="4dp" app:layout_constraintTop_toBottomOf="@id/welcomeTitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
        <ImageView android:id="@+id/welcomeArt" android:layout_width="0dp" android:layout_height="0dp" android:src="@drawable/art_splash" android:scaleType="fitXY" android:contentDescription="Những tấm ảnh giữa phong cảnh núi xanh" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintTop_toBottomOf="@id/welcomeSubtitle"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/start" style="@style/PrimaryButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginHorizontal="60dp" android:text="Bắt đầu" android:textSize="16sp" android:layout_marginBottom="8dp" app:layout_constraintBottom_toTopOf="@id/guest" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/guest" style="@style/TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Khám phá trên thiết bị" android:textSize="14sp" android:backgroundTint="@color/primary_light" android:layout_marginBottom="36dp" app:cornerRadius="14dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
