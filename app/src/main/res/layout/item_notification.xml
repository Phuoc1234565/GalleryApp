<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="88dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="16dp">
    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle_icon" android:padding="10dp" android:src="@drawable/ic_notification" app:tint="@color/primary" android:contentDescription="Thông báo"/>
    <TextView android:id="@+id/notificationMessage" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:textSize="15sp" android:textColor="@color/text_primary" android:lineSpacingExtra="5dp"/>
</LinearLayout>
