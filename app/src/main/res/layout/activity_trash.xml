        <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="16dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/emptyTrash" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:text="Dọn sạch thùng rác" android:letterSpacing="0"/>
    </LinearLayout>
</LinearLayout>
