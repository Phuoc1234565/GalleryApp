<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/viewer_background">
    <FrameLayout android:layout_width="match_parent" android:layout_height="56dp">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="match_parent" app:navigationIcon="@drawable/ic_arrow_back" app:navigationIconTint="@color/text_primary"/>
        <ImageButton android:id="@+id/more" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_more_vert" app:tint="@color/text_primary" android:contentDescription="Thông tin và thao tác"/>
    </FrameLayout>
    <ImageView android:id="@+id/photo" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="Ảnh đang xem"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="@color/text_secondary" android:fontFamily="sans-serif" android:id="@+id/status" android:padding="12dp" android:visibility="gone"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@color/viewer_controls">
        <com.google.android.material.button.MaterialButton android:id="@+id/favorite" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="76dp" android:text="Yêu thích" android:textColor="@color/text_primary" android:textSize="12sp" android:letterSpacing="0" android:paddingHorizontal="0dp" app:icon="@drawable/ic_favorite_outline" app:iconGravity="textTop" app:iconTint="@color/text_primary" app:iconSize="22dp" app:iconPadding="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/edit" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="76dp" android:text="Chỉnh sửa" android:textColor="@color/text_primary" android:textSize="12sp" android:letterSpacing="0" android:paddingHorizontal="0dp" app:icon="@drawable/ic_edit" app:iconGravity="textTop" app:iconTint="@color/text_primary" app:iconSize="22dp" app:iconPadding="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/share" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="76dp" android:text="Chia sẻ" android:textColor="@color/text_primary" android:textSize="12sp" android:letterSpacing="0" android:paddingHorizontal="0dp" app:icon="@drawable/ic_share" app:iconGravity="textTop" app:iconTint="@color/text_primary" app:iconSize="22dp" app:iconPadding="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/deletePhoto" style="@style/TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="76dp" android:text="Xóa" android:textColor="@color/text_primary" android:textSize="12sp" app:icon="@drawable/ic_delete" app:iconGravity="textTop" app:iconTint="@color/text_primary" app:iconSize="22dp"/>
    </LinearLayout>
</LinearLayout>
